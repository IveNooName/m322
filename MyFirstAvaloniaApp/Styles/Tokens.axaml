<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Abstände als Double (für Spacing, Width, Height ...) -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">16</x:Double>
    <x:Double x:Key="SpaceLg">24</x:Double>

    <!-- Abstände als Thickness (für Padding und Margin) -->
    <Thickness x:Key="PaddingSm">8</Thickness>
    <Thickness x:Key="PaddingMd">16</Thickness>
    <Thickness x:Key="PaddingLg">24</Thickness>

    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <x:Double x:Key="TouchTarget">44</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BrandPrimaryBrush">#2F6FED</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="PageBackgroundBrush">#F7F9FC</SolidColorBrush>
            <SolidColorBrush x:Key="TextMutedBrush">#6B7280</SolidColorBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BrandPrimaryBrush">#6B9BFF</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceBrush">#1B1E24</SolidColorBrush>
            <SolidColorBrush x:Key="PageBackgroundBrush">#12141A</SolidColorBrush>
            <SolidColorBrush x:Key="TextMutedBrush">#9CA3AF</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>